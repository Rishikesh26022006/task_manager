    {
      "name": "5. AI - generate description",
      "item": [
        {
          "name": "Generate description (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/generate-description",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "generate-description"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix login bug\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Returns 200 with a description. If the AI service is busy or the key is wrong, a clean JSON error (502/503/504/429) is returned instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is one of [200, 429, 502, 503, 504]\", function () { pm.expect([200, 429, 502, 503, 504]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Description returned\", function () {",
                  "    var d = pm.response.json().description;",
                  "    pm.expect(d).to.be.a(\"string\");",
                  "    pm.expect(d.length).to.be.above(10);",
                  "  });",
                  "} else {",
                  "  pm.test(\"AI failure is returned as clean JSON\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\"); });",
                  "}"
                ]
              }
            }
          ]
        },
